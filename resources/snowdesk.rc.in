#include <windows.h>
#pragma code_page(65001)

101 ICON "@CMAKE_CURRENT_SOURCE_DIR@/resources/snowdesk.ico"
1 RT_MANIFEST "@SNOW_GENERATED_DIR@/snowdesk.manifest"

1 VERSIONINFO
 FILEVERSION @SNOW_VERSION_RESOURCE@
 PRODUCTVERSION @SNOW_VERSION_RESOURCE@
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "FileDescription", "speeecial (snow desktop)\0"
            VALUE "FileVersion", "@PROJECT_VERSION@\0"
            VALUE "ProductName", "speeecial (snow desktop)\0"
            VALUE "ProductVersion", "@PROJECT_VERSION@\0"
            VALUE "OriginalFilename", "speeecial.exe\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
